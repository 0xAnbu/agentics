# Copy to .env (make dev does it for you and generates a random admin token).
# NEVER commit .env.

# Bootstrap admin credential. Generate with: python -m agentlink.cli gen-token
AGENTLINK_ADMIN_TOKEN=al_replace_me

# Empty => SQLite at AGENTLINK_DB_PATH. Vercel+Neon sets DATABASE_URL automatically.
DATABASE_URL=
AGENTLINK_DB_PATH=data/agentlink.db

# Optional: secret shared with GitHub repo webhooks (Settings -> Webhooks).
GITHUB_WEBHOOK_SECRET=

# Tuning (defaults shown)
# AGENTLINK_MAX_WAIT=25          # long-poll ceiling, seconds
# AGENTLINK_POLL_INTERVAL=1.0    # DB re-check during long-poll (2.0 on Postgres)
# AGENTLINK_WRITE_RATE=240       # writes per agent per minute
# AGENTLINK_READ_RATE=1200       # reads per agent per minute (per process)
# AGENTLINK_ALLOWED_ORIGINS=     # extra browser origins allowed on /mcp
# AGENTLINK_LOG_LEVEL=INFO
